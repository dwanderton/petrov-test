# mad environment variables
# Copy this file to .env.local and fill in ONE of the two auth options below.
# Both are read server-side only by the Vercel AI Gateway client.

# Option 1 (simplest): a static AI Gateway API key.
# Create one at https://vercel.com/<team>/~/ai → API keys.
AI_GATEWAY_API_KEY=

# Option 2: OIDC. Run `vercel link` then `vercel env pull .env.local`.
# That writes a short-lived VERCEL_OIDC_TOKEN (~24h) here automatically;
# re-pull when it expires. Leave AI_GATEWAY_API_KEY empty in that case.
